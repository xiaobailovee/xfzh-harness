# pnpm still reads registry/auth from .npmrc. Electron and node-gyp install
# scripts also read these keys as npm_config_* / ELECTRON_MIRROR. There is no
# .pnpmrc; pnpm-only settings belong in pnpm-workspace.yaml.
registry=https://registry.npmmirror.com

# @electron/get: {mirror}{version}/electron-vX.Y.Z-win32-x64.zip
electron_mirror=https://npmmirror.com/mirrors/electron/
electron_builder_binaries_mirror=https://npmmirror.com/mirrors/electron-builder-binaries/

# node-gyp / node-pty / koffi Node headers
disturl=https://npmmirror.com/mirrors/node/
nodejs_org_mirror=https://npmmirror.com/mirrors/node/
